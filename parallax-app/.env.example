# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server access (Project settings > Service accounts > Generate new private key).
# Paste the whole JSON file base64-encoded:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
